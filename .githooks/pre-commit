#!/usr/bin/env bash
# pre-commit hook (non-blocking warnings):
#   1) DEPLOY DRIFT — if a canonical skill changed, warn when ~/.claude & ~/.codex copies are stale.
#   2) STALENESS    — if core code changed, warn when skills' last_verified is outdated.
# Anthropic pattern: "90% of PRs include skill updates" — keep source, deploy copies, and freshness in lockstep.
#
# Install: git config core.hooksPath .githooks
set -e
REPO="$(git rev-parse --show-toplevel)"
cd "$REPO"

STAGED=$(git diff --cached --name-only --diff-filter=ACM || true)
CHANGED_SKILLS=$(echo "$STAGED" | grep '^skills/' || true)
CHANGED_PY=$(echo "$STAGED" | grep '\.py$' || true)

# 1) Deploy drift: canonical skills/ changed -> the local Claude/Codex deploy copies may be out of sync.
if [ -n "$CHANGED_SKILLS" ] && [ -f deploy_skills.sh ]; then
  if OUT=$(bash deploy_skills.sh --check 2>&1); then
    echo "[pre-commit] skill deploy copies in sync (~/.claude, ~/.codex)."
  else
    echo ""
    echo "[pre-commit] WARNING: canonical skills changed but deploy copies are STALE:"
    echo "$OUT" | grep -E 'DRIFT|STALE' | head
    echo "  Redeploy:  bash deploy_skills.sh   (Windows: .\\deploy_skills.ps1)"
    echo ""
  fi
fi

# 2) Staleness: core code changed -> skills' last_verified may be outdated.
CORE_CHANGED=$(echo "$CHANGED_PY" | grep -E '^(refledger|refrecord|refextract|refinsight|refocr|refsep)\.py$' || true)
if [ -n "$CORE_CHANGED" ]; then
  echo "[pre-commit] Core code changed: $(echo "$CORE_CHANGED" | tr '\n' ' ')"
  if python check_skill_staleness.py --ttl 30 >/dev/null 2>&1; then
    echo "[pre-commit] All skills fresh."
  else
    echo "[pre-commit] WARNING: stale skill docs. Run: python check_skill_staleness.py --fix"
  fi
fi

exit 0
