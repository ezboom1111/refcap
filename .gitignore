# ── refcap .gitignore ──
# Raw media + per-investigation scratch (don't-hoard: keep extracts+hashes, not raw bytes)
refs/*
!refs/_acc_records/
dl/
research/

# Python
__pycache__/
*.py[cod]

# Runtime locks
.ledger.lock
**/.ledger.lock

# Secrets (NEVER commit — keys live in env/registry, not files)
.env
.env.*
*.key
*.pem
credentials*
secrets*

# Node
node_modules/

# OS
Thumbs.db
.DS_Store
_stress/
_smoke.jsonl
_stress_mismatches.txt
_gradgem_report.md
_alpha_report.md
_alpha_demo_out.json
_alpha_round2.md
# QA scratch byproducts (farm bundles + investigator helper scripts + stray root runs/dumps)
_alpha_*/
_leesearch_findings*.py
/r_*/
/art/
/runs/
# QA investigators sometimes write extraction scratch to cwd instead of their run dir (folder-contract slip):
_ge_*
_q_*
_sanil_*
_numbeo_*
_tax_*
_viol_*
_visa_*
